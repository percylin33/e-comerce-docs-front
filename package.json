{
  "name": "ngx-admin",
  "version": "11.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akveo/ngx-admin.git"
  },
  "bugs": {
    "url": "https://github.com/akveo/ngx-admin/issues"
  },
  "scripts": {
    "ng": "ng",
    "conventional-changelog": "conventional-changelog",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "npm run build -- --configuration production --aot",
    "build:staging": "npm run build -- --configuration staging --aot",
    "build:analyze": "ng build --configuration production --stats-json && npx -y esbuild-visualizer --metadata dist/stats.json --filename dist/bundle-report.html --open",
    "lighthouse": "npx -y lighthouse http://localhost:4200 --preset=desktop --view --output=html --output-path=./lighthouse-report.html",
    "test": "ng test",
    "test:ci": "ng test --browsers=ChromeHeadlessCI --watch=false --source-map=false",
    "test:coverage": "rimraf coverage && npm run test -- --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint ngx-admin-demo --fix",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:ci": "npm run lint",
    "docs": "compodoc -p src/tsconfig.app.json -d docs",
    "docs:serve": "compodoc -p src/tsconfig.app.json -d docs -s",
    "prepush": "npm run lint:ci",
    "release:changelog": "npm run conventional-changelog -- -p angular -i CHANGELOG.md -s"
  },
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/elements": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/pwa": "^18.2.21",
    "@angular/router": "^18.2.14",
    "@angular/service-worker": "^18.2.14",
    "@nebular/auth": "^14.0.2",
    "@nebular/eva-icons": "^14.0.2",
    "@nebular/security": "^14.0.2",
    "@nebular/theme": "^14.0.2",
    "angular-oauth2-oidc": "^17.0.2",
    "apexcharts": "3.41.0",
    "bootstrap": "4.3.1",
    "dompurify": "^3.3.2",
    "eva-icons": "^1.1.3",
    "html2canvas": "^1.4.1",
    "ionicons": "2.0.1",
    "jspdf": "^3.0.2",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.34",
    "lodash": "^4.17.21",
    "nebular-icons": "1.1.0",
    "ng-apexcharts": "1.7.6",
    "ngx-extended-pdf-viewer": "^17.4.10",
    "ngx-paypal": "^11.0.0",
    "rxjs": "7.8.2",
    "swiper": "^11.1.14",
    "tslib": "^2.3.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@angular/language-service": "18.2.14",
    "@compodoc/compodoc": "1.0.1",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@types/d3-color": "1.0.5",
    "@types/jasmine": "~3.3.0",
    "@types/node": "^12.12.70",
    "@types/webpack-env": "^1.18.8",
    "@types/ws": "^7.4.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "conventional-changelog-cli": "1.3.4",
    "eslint": "^8.57.1",
    "husky": "0.13.3",
    "jasmine-core": "^3.8.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.19",
    "karma-chrome-launcher": "~3.1.1",
    "karma-cli": "1.0.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.2",
    "karma-jasmine-html-reporter": "^1.7.0",
    "npm-run-all": "4.0.2",
    "rimraf": "2.6.1",
    "stylelint": "7.13.0",
    "ts-node": "3.2.2",
    "typescript": "~5.5.4",
    "webpack": "^5.101.3"
  }
}
